<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileKeep.Reader.iOS.App">
	<Application.Resources>
		<ResourceDictionary>
			<!-- Windows dark palette parity (FileKeep desktop dark theme) -->
			<Color x:Key="BrandPrimary">#0067C0</Color>
			<Color x:Key="BrandAccent">#0067C0</Color>
			<Color x:Key="PageBackground">#202020</Color>
			<Color x:Key="Surface">#2b2b2b</Color>
			<Color x:Key="TextPrimary">#f3f3f3</Color>
			<Color x:Key="TextSecondary">#a7a7a7</Color>
			<Color x:Key="Divider">#353535</Color>
			<Color x:Key="StatusOk">#6ccb5f</Color>
			<Color x:Key="StatusError">#f1707b</Color>
			<Color x:Key="StatusWarn">#f7b955</Color>

			<Style TargetType="Page" ApplyToDerivedTypes="True">
				<Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
			</Style>

			<Style TargetType="Button">
				<Setter Property="BackgroundColor" Value="{StaticResource BrandAccent}" />
				<Setter Property="TextColor" Value="White" />
				<Setter Property="CornerRadius" Value="6" />
				<Setter Property="Padding" Value="16,10" />
				<Setter Property="FontAttributes" Value="Bold" />
			</Style>

			<Style x:Key="AppTitle" TargetType="Label">
				<Setter Property="TextColor" Value="{StaticResource BrandAccent}" />
				<Setter Property="FontSize" Value="24" />
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<Style x:Key="StatusText" TargetType="Label">
				<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
				<Setter Property="FontSize" Value="13" />
			</Style>

			<Style x:Key="FileName" TargetType="Label">
				<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="15" />
			</Style>

			<Style x:Key="FileSize" TargetType="Label">
				<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
				<Setter Property="FontSize" Value="12" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
