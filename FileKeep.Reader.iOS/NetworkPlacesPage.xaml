<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileKeep.Reader.iOS.NetworkPlacesPage"
             Title="Network places">
	<!-- Modal page (MainPage is not in a NavigationPage): the form stays
	     fixed at the top, the browse list fills the rest, progress and
	     status sit at the bottom. Same dark palette as the vault. -->
	<Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12"
	      BackgroundColor="{StaticResource PageBackground}">
		<VerticalStackLayout Grid.Row="0" Spacing="12">
			<HorizontalStackLayout Spacing="10">
				<Label Text="Network places" FontSize="22" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}"
				       VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
				<Button x:Name="CloseButton" Text="Close" Clicked="OnCloseClicked"
				        BackgroundColor="{StaticResource Surface}"
				        TextColor="{StaticResource TextPrimary}" />
			</HorizontalStackLayout>
			<Label Text="Server" Style="{StaticResource StatusText}" />
			<Entry x:Name="ServerEntry" Placeholder="laptop or 192.168.1.10"
			       BackgroundColor="{StaticResource Surface}"
			       TextColor="{StaticResource TextPrimary}"
			       PlaceholderColor="{StaticResource TextSecondary}" />
			<Label Text="Username" Style="{StaticResource StatusText}" />
			<Entry x:Name="UsernameEntry" Placeholder="Muser"
			       BackgroundColor="{StaticResource Surface}"
			       TextColor="{StaticResource TextPrimary}"
			       PlaceholderColor="{StaticResource TextSecondary}" />
			<Label Text="Password" Style="{StaticResource StatusText}" />
			<Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Share password"
			       BackgroundColor="{StaticResource Surface}"
			       TextColor="{StaticResource TextPrimary}"
			       PlaceholderColor="{StaticResource TextSecondary}" />
			<Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked"
			        BackgroundColor="{StaticResource BrandAccent}" TextColor="White" />
			<Label x:Name="SavedServersLabel" Text="Saved servers" Style="{StaticResource StatusText}"
			       IsVisible="False" />
			<Picker x:Name="SavedServersPicker" IsVisible="False"
			        BackgroundColor="{StaticResource Surface}"
			        TextColor="{StaticResource TextPrimary}"
			        SelectedIndexChanged="OnSavedServerSelected" />
			<BoxView HeightRequest="1" Color="{StaticResource Divider}" />
			<Label x:Name="PathLabel" Text="Not connected" FontAttributes="Bold"
			       TextColor="{StaticResource TextPrimary}" />
			<Label x:Name="BrowseHintLabel" Text="Only .kfb bundles are shown." FontSize="12"
			       TextColor="{StaticResource TextSecondary}" />
			<!-- Save mode: filename entry + Save here button. Hidden in
			     browse mode; shown by NetworkPlacesPage.ForSave. -->
			<Entry x:Name="SaveFileEntry" Placeholder="bundle name.kfb" IsVisible="False"
			       BackgroundColor="{StaticResource Surface}"
			       TextColor="{StaticResource TextPrimary}"
			       PlaceholderColor="{StaticResource TextSecondary}" />
			<Button x:Name="SaveHereButton" Text="Save here" Clicked="OnSaveHereClicked" IsVisible="False"
			        BackgroundColor="{StaticResource BrandAccent}" TextColor="White" />
			<Button x:Name="BackButton" Text="‹ Back" Clicked="OnBackClicked" IsVisible="False"
			        BackgroundColor="{StaticResource Surface}"
			        TextColor="{StaticResource TextPrimary}" />
		</VerticalStackLayout>
		<CollectionView x:Name="BrowseView" Grid.Row="1" SelectionMode="Single"
		                SelectionChanged="OnBrowseSelected">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Frame CornerRadius="6" Padding="0" HasShadow="False"
					       BackgroundColor="{StaticResource Surface}" Margin="0,0,0,8">
						<Grid ColumnDefinitions="Auto,*" Padding="12,10" ColumnSpacing="12">
							<Frame CornerRadius="6" Padding="0" HasShadow="False"
							       BackgroundColor="#3A3A3A" WidthRequest="44" HeightRequest="44"
							       VerticalOptions="Center">
								<Path Data="{Binding IconData}" WidthRequest="26" HeightRequest="26"
								       HorizontalOptions="Center" VerticalOptions="Center"
								       Aspect="None" Fill="Transparent"
								       Stroke="{StaticResource TextPrimary}"
								       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
							</Frame>
							<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
								<Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"
								       TextColor="{StaticResource TextPrimary}" />
								<Label Text="{Binding SizeText}" FontSize="12"
								       TextColor="{StaticResource TextSecondary}" />
							</VerticalStackLayout>
						</Grid>
					</Frame>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<VerticalStackLayout Grid.Row="2" Spacing="8">
			<ProgressBar x:Name="DownloadProgress" IsVisible="False"
			             ProgressColor="{StaticResource BrandAccent}" />
			<Label x:Name="DownloadStatusLabel" IsVisible="False" Style="{StaticResource StatusText}" />
			<Button x:Name="CancelDownloadButton" Text="Cancel download" IsVisible="False"
			        Clicked="OnCancelDownloadClicked"
			        BackgroundColor="{StaticResource Surface}"
			        TextColor="{StaticResource TextPrimary}" />
			<Label x:Name="StatusLabel" Style="{StaticResource StatusText}" />
		</VerticalStackLayout>
	</Grid>
</ContentPage>
