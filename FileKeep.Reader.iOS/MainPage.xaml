<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileKeep.Reader.iOS.MainPage"
             Title="FileKeep Reader">
	<Grid RowDefinitions="*,Auto">
		<!-- Content area: overlapping views, visibility toggled by the tab bar -->
		<Grid Grid.Row="0">
			<!-- Vault list view: the new home screen ("My Bundles") -->
			<Grid x:Name="VaultView" Padding="20" RowSpacing="12"
			      RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
				<SearchBar x:Name="VaultSearchBar" Grid.Row="0" Placeholder="Search bundles"
				           BackgroundColor="{StaticResource Surface}"
				           TextColor="{StaticResource TextPrimary}"
				           PlaceholderColor="{StaticResource TextSecondary}"
				           TextChanged="OnSearchTextChanged" />
				<Label Grid.Row="1" Text="My Bundles" FontSize="28" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}" />
				<Label x:Name="VaultSubtitleLabel" Grid.Row="2"
				       Text="0 bundles · Encrypted &amp; offline"
				       Style="{StaticResource StatusText}" />
				<CollectionView x:Name="VaultListView" Grid.Row="3" SelectionMode="Single"
				                SelectionChanged="OnRecentSelected">
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<Frame CornerRadius="6" Padding="0" HasShadow="False"
							       BackgroundColor="{StaticResource Surface}" Margin="0,0,0,8">
								<Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" ColumnSpacing="12">
									<Frame CornerRadius="6" Padding="0" HasShadow="False"
									       BackgroundColor="#3A3A3A" WidthRequest="44" HeightRequest="44"
									       VerticalOptions="Center">
										<Path Data="{Binding IconData}" WidthRequest="26" HeightRequest="26"
										       HorizontalOptions="Center" VerticalOptions="Center"
										       Aspect="None" Fill="Transparent"
										       Stroke="{StaticResource TextPrimary}"
										       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
									</Frame>
									<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
										<Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"
										       TextColor="{StaticResource TextPrimary}" />
										<HorizontalStackLayout Spacing="8">
											<Frame CornerRadius="8" Padding="8,2" HasShadow="False"
											       BackgroundColor="White">
												<Label Text="{Binding BadgeMethod}" FontSize="12"
												       FontAttributes="Bold"
												       TextColor="{Binding BadgeColor}" />
											</Frame>
											<Label Text="{Binding FileCountText}" FontSize="12"
											       TextColor="{StaticResource TextSecondary}"
											       VerticalOptions="Center" />
										</HorizontalStackLayout>
									</VerticalStackLayout>
									<Label Grid.Column="2" Text="{Binding ModifiedText}" FontSize="12"
									       TextColor="{StaticResource TextSecondary}"
									       VerticalOptions="Center" HorizontalOptions="End" />
								</Grid>
							</Frame>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
				<Label x:Name="VaultStatusLabel" Grid.Row="4" Style="{StaticResource StatusText}" />
				<Label x:Name="VersionLabel" Grid.Row="5" Text="v0.0.8"
				       FontSize="10" TextColor="#666666"
				       HorizontalOptions="Center" Margin="0,4,0,2" />
			</Grid>

			<!-- Bundle view: the existing open/preview/edit workspace, unchanged -->
			<VerticalStackLayout x:Name="BundleView" Padding="20" Spacing="12" IsVisible="False">
				<!-- Branded header -->
				<HorizontalStackLayout Spacing="10">
					<Image Source="filekeep_logo.png" HeightRequest="36" WidthRequest="36"
					       VerticalOptions="Center" />
					<Label Text="FileKeep Reader" Style="{StaticResource AppTitle}" />
				</HorizontalStackLayout>
				<BoxView HeightRequest="1" Color="{StaticResource Divider}" />
				<Label x:Name="StatusLabel" Text="No bundle open." Style="{StaticResource StatusText}" />
				<HorizontalStackLayout Spacing="8">
					<Label Text="Files" Style="{StaticResource AppTitle}" FontSize="16"
					       VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
					<Button x:Name="AddFileButton" Text="Add" Clicked="OnAddFileClicked" IsVisible="False"
					        FontSize="13" Padding="12,6" />
				</HorizontalStackLayout>
				<CollectionView x:Name="FilesView" SelectionMode="Single"
				                SelectionChanged="OnFileSelected" HeightRequest="200">
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<VerticalStackLayout Padding="8">
								<Label Text="{Binding Path}" Style="{StaticResource FileName}" />
								<Label Text="{Binding Size, StringFormat='{0} bytes'}" Style="{StaticResource FileSize}" />
							</VerticalStackLayout>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
				<HorizontalStackLayout Spacing="8">
					<Button x:Name="SaveButton" Text="Save bundle" Clicked="OnSaveClicked"
					        IsVisible="False" HorizontalOptions="FillAndExpand" />
					<Button x:Name="UploadButton" Text="Upload" Clicked="OnUploadClicked"
					        IsVisible="False" HorizontalOptions="FillAndExpand" />
				</HorizontalStackLayout>
				<!-- Flexible preview area -->
				<ContentView x:Name="PreviewContainer" VerticalOptions="FillAndExpand">
					<Label x:Name="PreviewPlaceholder" Text="Select a file to preview."
					       Style="{StaticResource StatusText}"
					       HorizontalOptions="Center" VerticalOptions="Center" />
				</ContentView>
			</VerticalStackLayout>

			<!-- Activity placeholder: content to be decided -->
			<VerticalStackLayout x:Name="ActivityView" IsVisible="False" Padding="20" Spacing="8"
			                     VerticalOptions="Center">
				<Label Text="Activity" FontSize="28" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
				<Label Text="Recent bundle activity will appear here."
				       Style="{StaticResource StatusText}" HorizontalOptions="Center" />
			</VerticalStackLayout>

			<!-- Settings placeholder: content to be decided -->
			<VerticalStackLayout x:Name="SettingsView" IsVisible="False" Padding="20" Spacing="8"
			                     VerticalOptions="Center">
				<Label Text="Settings" FontSize="28" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
				<Label Text="App settings will live here."
				       Style="{StaticResource StatusText}" HorizontalOptions="Center" />
			</VerticalStackLayout>
		</Grid>

		<!-- Bottom tab bar: floating rounded bar (RBP Obvious mockup) —
		     stacked line icon over label, active tab white, inactive gray. -->
		<Frame Grid.Row="1" CornerRadius="18" Padding="10" HasShadow="False"
		       BackgroundColor="{StaticResource Surface}" Margin="16,0,16,12">
			<Grid ColumnDefinitions="*,*,*,*,*">
				<VerticalStackLayout Grid.Column="0" Spacing="3">
					<Path x:Name="VaultTabIcon" Data="M 9.75,13 L 9.75,8.94 A 3.25,4.6 0 0 1 13,4.33 A 3.25,4.6 0 0 1 16.25,8.94 L 16.25,13 M 9.75,13 L 16.25,13 A 2.17,2.17 0 0 1 18.42,15.17 L 18.42,19.5 A 2.17,2.17 0 0 1 16.25,21.67 L 9.75,21.67 A 2.17,2.17 0 0 1 7.58,19.5 L 7.58,15.17 A 2.17,2.17 0 0 1 9.75,13 Z"
					       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"
					       Aspect="None" Fill="Transparent" Stroke="White"
					       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
					<Label x:Name="VaultTabLabel" Text="Vault" FontSize="11" FontAttributes="Bold"
					       TextColor="White" HorizontalOptions="Center" />
					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnVaultTabClicked" />
					</VerticalStackLayout.GestureRecognizers>
				</VerticalStackLayout>
				<VerticalStackLayout Grid.Column="1" Spacing="3">
					<Path x:Name="ActivityTabIcon" Data="M 4.88,13 A 8.12,8.12 0 0 1 13,4.88 A 8.12,8.12 0 0 1 21.12,13 A 8.12,8.12 0 0 1 13,21.12 A 8.12,8.12 0 0 1 4.88,13 Z M 13,13 L 13,8.12 M 13,13 L 16.79,14.62"
					       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"
					       Aspect="None" Fill="Transparent" Stroke="{StaticResource TextSecondary}"
					       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
					<Label x:Name="ActivityTabLabel" Text="Activity" FontSize="11"
					       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnActivityTabClicked" />
					</VerticalStackLayout.GestureRecognizers>
				</VerticalStackLayout>
				<VerticalStackLayout Grid.Column="2" Spacing="3">
					<Path x:Name="NewTabIcon" Data="M 5.96,13 L 20.04,13 M 13,5.96 L 13,20.04"
					       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"
					       Aspect="None" Fill="Transparent" Stroke="{StaticResource TextSecondary}"
					       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
					<Label x:Name="NewTabLabel" Text="New" FontSize="11"
					       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnNewClicked" />
					</VerticalStackLayout.GestureRecognizers>
				</VerticalStackLayout>
				<VerticalStackLayout Grid.Column="3" Spacing="3">
					<Path x:Name="OpenTabIcon" Data="M 4,9 L 9,9 L 10.5,6 L 15.5,6 L 17,9 L 22,9 L 22,18 A 2,2 0 0 1 20,20 L 6,20 A 2,2 0 0 1 4,18 Z M 13,17 L 13,3.5 M 9.75,6.75 L 13,3.5 L 16.25,6.75"
					       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"
					       Aspect="None" Fill="Transparent" Stroke="{StaticResource TextSecondary}"
					       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
					<Label x:Name="OpenTabLabel" Text="Open" FontSize="11"
					       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnOpenTabClicked" />
					</VerticalStackLayout.GestureRecognizers>
				</VerticalStackLayout>
				<VerticalStackLayout Grid.Column="4" Spacing="3">
					<Path x:Name="SettingsTabIcon" Data="M 19.31,11.43 L 21.58,11.79 L 21.58,14.21 L 19.31,14.57 L 19.01,15.49 L 18.57,16.35 L 19.92,18.22 L 18.22,19.92 L 16.35,18.57 L 15.49,19.01 L 14.57,19.31 L 14.21,21.58 L 11.79,21.58 L 11.43,19.31 L 10.51,19.01 L 9.65,18.57 L 7.78,19.92 L 6.08,18.22 L 7.43,16.35 L 6.99,15.49 L 6.69,14.57 L 4.42,14.21 L 4.42,11.79 L 6.69,11.43 L 6.99,10.51 L 7.43,9.65 L 6.08,7.78 L 7.78,6.08 L 9.65,7.43 L 10.51,6.99 L 11.43,6.69 L 11.79,4.42 L 14.21,4.42 L 14.57,6.69 L 15.49,6.99 L 16.35,7.43 L 18.22,6.08 L 19.92,7.78 L 18.57,9.65 L 19.01,10.51 Z M 9.75,13 A 3.25,3.25 0 0 1 13,9.75 A 3.25,3.25 0 0 1 16.25,13 A 3.25,3.25 0 0 1 13,16.25 A 3.25,3.25 0 0 1 9.75,13 Z"
					       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"
					       Aspect="None" Fill="Transparent" Stroke="{StaticResource TextSecondary}"
					       StrokeThickness="1.9" StrokeLineCap="Round" StrokeLineJoin="Round" />
					<Label x:Name="SettingsTabLabel" Text="Settings" FontSize="11"
					       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
					<VerticalStackLayout.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnSettingsTabClicked" />
					</VerticalStackLayout.GestureRecognizers>
				</VerticalStackLayout>
			</Grid>
		</Frame>
	</Grid>
</ContentPage>
