<Project Sdk="Microsoft.NET.Sdk.Maui">

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>iossimulator-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>FileKeep.Reader.iOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>FileKeep Reader</ApplicationTitle>
    <ApplicationId>com.filekeep.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <CodesignProvision>Automatic</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <!-- FileKeep.Core: envelope helpers, PBKDF2, AES-GCM, JSON.
         Single-sourced — never reimplemented here. Provided by the
         external/FileKeep submodule, pinned to a FileKeep release. -->
    <ProjectReference Include="../../external/FileKeep/src/FileKeep.Core/FileKeep.Core.csproj" />
  </ItemGroup>

</Project>
