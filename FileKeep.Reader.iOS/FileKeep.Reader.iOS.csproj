<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>iossimulator-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>FileKeep.Reader.iOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>FileKeep Reader</ApplicationTitle>
    <ApplicationId>com.filekeep.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'">Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <CodesignProvision Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'">Automatic</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <ProjectReference Include="../external/FileKeep/src/FileKeep.Core/FileKeep.Core.csproj" />
  </ItemGroup>

</Project>
