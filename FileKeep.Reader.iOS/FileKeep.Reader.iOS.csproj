<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>iossimulator-arm64;ios-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>FileKeep.Reader.iOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationTitle>FileKeep Reader</ApplicationTitle>
    <ApplicationId>com.filekeep.reader</ApplicationId>
    <ApplicationDisplayVersion>0.0.12</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'">Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <CodesignProvision Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'">Automatic</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <ProjectReference Include="../external/FileKeep/src/FileKeep.Core/FileKeep.Core.csproj" />
  </ItemGroup>

  <!-- Branding: FileKeep app icon, splash screen, in-app logo -->
  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash_icon.png" Color="#1B1B1B" />
    <MauiImage Include="Resources/Images/filekeep_logo.png" />
  </ItemGroup>

  <!-- App icons as BundleResource (asset pipeline broken with this SDK) -->
  <!-- Link flattens to bundle root where CFBundleIconFiles expects them -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Resources/BundleIcons/*.png">
      <Link>%(Filename)%(Extension)</Link>
    </BundleResource>
  </ItemGroup>

  <!-- Rust smb-ffi static library, built in CI from text source (never
       committed): one .a per RuntimeIdentifier. The Security framework
       is needed because Rust's getrandom uses SecRandomCopyBytes, and
       that link directive does not propagate out of a staticlib. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="Rust\smb-ffi\target\aarch64-apple-ios\release\libsmb_ffi.a" Kind="Static" ForceLoad="true" SmartLink="false">
      <Frameworks>Security</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <NativeReference Include="Rust\smb-ffi\target\aarch64-apple-ios-sim\release\libsmb_ffi.a" Kind="Static" ForceLoad="true" SmartLink="false">
      <Frameworks>Security</Frameworks>
    </NativeReference>
  </ItemGroup>

</Project>
